{
  "name": "ration",
  "productName": "Ration",
  "description": "Local-first workspace for notes, databases, and planning.",
  "author": {
    "name": "rick868",
    "email": "maintainers@ration.app"
  },
  "private": true,
  "version": "1.0.2",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "start": "electron .",
    "package:deb": "npm run clean && npm run build && electron-builder --linux deb --publish never",
    "package:appimage": "npm run clean && npm run build && electron-builder --linux appImage --publish never",
    "package:tar": "npm run clean && npm run build && electron-builder --linux tar.gz --publish never",
    "package:linux": "npm run clean && npm run build && electron-builder --linux deb appImage tar.gz --publish never",
    "dist": "npm run package:linux"
  },
  "build": {
    "appId": "com.ration.app",
    "productName": "Ration",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "public/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2 | libasound2t64",
        "libdrm2",
        "libgbm1",
        "libx11-xcb1",
        "libxkbfile1"
      ],
      "packageCategory": "utils",
      "priority": "optional"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.AppImage"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^36.4.0",
    "electron-builder": "^25.1.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
